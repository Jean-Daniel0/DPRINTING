# Copiez ce fichier vers .env.local et renseignez les valeurs.
# En production, toutes les variables marquées « obligatoire » doivent être définies sur Render.

NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000

# PostgreSQL (Supabase pooler). Laisser vide pour utiliser PGlite en développement.
DATABASE_URL=

# Stockage : local en développement, supabase en production.
STORAGE_DRIVER=local
DATA_DIR=.data
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=dprinting

# Administration. En production : SESSION_SECRET, ADMIN_EMAIL et ADMIN_PASSWORD_HASH sont obligatoires.
SESSION_SECRET=
ADMIN_EMAIL=admin@dprinting.local
# Hash généré par `npm run admin:hash -- "mot-de-passe"`. Laisser vide en développement utilise le compte admin@dprinting.local / dprinting-dev.
ADMIN_PASSWORD_HASH=

# Limites d'upload (Mo).
MAX_SOURCE_MB=15
MAX_PREVIEW_MB=25
MAX_PRODUCTION_MB=60
