{
  "name": "dprinting",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "npm run dev -w @dprinting/web",
    "dev:server": "npm run dev -w @dprinting/server",
    "build": "npm run build -w @dprinting/web && npm run build -w @dprinting/server",
    "start": "node apps/server/dist/server.mjs",
    "typecheck": "npm run typecheck -w @dprinting/core && npm run typecheck -w @dprinting/server && npm run typecheck -w @dprinting/web",
    "test": "npm run test -w @dprinting/core && npm run test -w @dprinting/server",
    "admin:hash": "npm run admin:hash -w @dprinting/server --"
  },
  "devDependencies": {
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@supabase/supabase-js": "^2.119.2",
    "express": "^5.3.0",
    "lucide-react": "^1.75.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  }
}
